{
  "name": "avenza-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Avenza — Plan. Execute. Evolve. A personal operating system for growth.",
  "scripts": {
    "dev": "pnpm --parallel --filter @avenza/api --filter @avenza/web dev",
    "dev:web": "pnpm --filter @avenza/web dev",
    "dev:api": "pnpm --filter @avenza/api dev",
    "build": "pnpm --filter @avenza/shared build && pnpm --filter @avenza/api build && pnpm --filter @avenza/web build",
    "test": "pnpm --recursive run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
