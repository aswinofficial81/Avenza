# ==============================================================================
# Avenza Monorepo - Global Environment Example
# Note: Copy individual examples to apps/web/.env and apps/api/.env as needed.
# ==============================================================================

# Backend (apps/api)
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Authentication (Clerk - planned for future phase)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Database (Supabase PostgreSQL - planned for future phase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Service (FreeLLM Unified API - planned for future phase)
# CRITICAL: Server-side only. NEVER expose this to the client.
FREELLM_API_KEY=your_freellm_api_key_here

# Phase 14 External Integrations (GitHub OAuth & Token Encryption)
# CRITICAL: Server-side only. NEVER expose GITHUB_CLIENT_SECRET or encryption keys to the frontend.
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/settings?provider=github
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/settings?provider=google_calendar
INTEGRATION_TOKEN_ENCRYPTION_KEY=32_byte_hex_or_base64_encryption_key_here

# Frontend (apps/web)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
VITE_API_BASE_URL=http://localhost:3001
