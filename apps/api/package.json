{
  "name": "@avenza/api",
  "version": "0.1.0",
  "private": true,
  "description": "Avenza API Service built with Fastify and TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "worker:deletion-recovery": "tsx src/modules/identity/account-deletion-recovery.runner.ts"
  },
  "dependencies": {
    "@avenza/shared": "workspace:*",
    "@clerk/backend": "^3.21.1",
    "@fastify/cors": "^11.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@avenza/config": "workspace:*",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.13.4",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
